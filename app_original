import duckdb
import pandas as pd
import plotly.express as px
import streamlit as st

# Page Configuration
st.set_page_config(
    page_title="NSW Emergency Department Analytics",
    page_icon="🏥",
    layout="wide",
)

# Connect to DuckDB (Read-Only mode for safety)
@st.cache_resource
def get_db_connection():
    return duckdb.connect("nsw_healthcare_analytics_original_Q1_2025.db", read_only=True)

con = get_db_connection()

# Load data from DuckDB table
@st.cache_data
def load_data():
    query = "SELECT * FROM nsw_hospital_performance;"
    return con.execute(query).fetchdf()

df = load_data()

# --- SIDEBAR FILTERS ---
st.sidebar.header("🎛️ Filter Controls")
selected_lhd = st.sidebar.multiselect(
    "Select Local Health District (LHD):",
    options=df["lhd_name"].unique(),
    default=df["lhd_name"].unique()
)

# Filter dataframe based on sidebar selection
filtered_df = df[df["lhd_name"].isin(selected_lhd)]

# --- MAIN DASHBOARD HEADER ---
st.title("🏥 NSW Emergency Department Capacity & Bottleneck Monitor")
st.markdown("Operational risk analytics tracking emergency department patient flows and 90th-percentile wait times across New South Wales health facilities.")

# --- TOP KPI METRICS ROW ---
col1, col2, col3 = st.columns(3)
with col1:
    total_presentations = int(filtered_df["ed_presentations"].sum())
    st.metric("Total ED Presentations", f"{total_presentations:,}")
with col2:
    avg_p90 = round(filtered_df["p90_wait_time_minutes"].mean(), 1)
    st.metric("Avg P90 Wait Time (Mins)", f"{avg_p90} mins")
with col3:
    avg_on_time = round(filtered_df["patients_within_4hrs_pct"].mean(), 1)
    st.metric("Avg 4-Hour Rule Compliance", f"{avg_on_time}%")

st.markdown("---")

# --- CHARTS SECTION ---
col_left, col_right = st.columns(2)

with col_left:
    st.subheader("📊 P90 Wait Times by Hospital")
    if not filtered_df.empty:
        fig_bar = px.bar(
            filtered_df.sort_values("p90_wait_time_minutes", ascending=True),
            x="p90_wait_time_minutes",
            y="hospital_name",
            color="peer_group",
            orientation="h",
            labels={"p90_wait_time_minutes": "P90 Wait Time (Minutes)", "hospital_name": "Hospital"},
            title="90th Percentile Wait Time (Threshold for 90% of Patients)"
        )
        st.plotly_chart(fig_bar, use_container_width=True)
    else:
        st.warning("Please select at least one Local Health District from the sidebar.")

with col_right:
    st.subheader("⚡ Presentations vs. Wait Times")
    if not filtered_df.empty:
        fig_scatter = px.scatter(
            filtered_df,
            x="ed_presentations",
            y="p90_wait_time_minutes",
            size="p90_wait_time_minutes",
            color="lhd_name",
            hover_name="hospital_name",
            labels={"ed_presentations": "ED Presentations", "p90_wait_time_minutes": "P90 Wait Time (Mins)"},
            title="Volume vs. Congestion Correlation"
        )
        st.plotly_chart(fig_scatter, use_container_width=True)
    else:
        st.warning("No data available for the selected filters.")

# --- DETAILED DATA TABLE ---
st.subheader("📋 Underlying Database Records")
st.dataframe(filtered_df, use_container_width=True)
